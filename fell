 questions:[
  ["⚽","Доп жолға домалап кетті. Не істейсің?",[["✋","Тоқтап, ересек адамнан көмек сұраймын",1],["🏃","Доптың артынан жүгіремін",0],["🚗","Көліктер арасынан өтемін",0]]],
  ["📱","Жолға жақындағанда телефонмен не істеген дұрыс?",[["👀","Телефонды қойып, жолға назар аудару",1],["📱","Хабарлама оқи беру",0],["🎧","Қатты музыка тыңдау",0]]],
  ["🌧️","Жаңбырлы күні көшеден қалай өткен дұрыс?",[["☂️","Асықпай, жолды мұқият тексеру",1],["🏃","Көлікке қарамай жүгіру",0],["🙈","Қарамай өту",0]]],
  ["🚌","Автобустан түскен соң не істеу керек?",[["🚸","Қауіпсіз жерге барып, өткелді пайдалану",1],["🏃","Автобустың алдынан жүгіріп өту",0],["🚗","Көліктер арасынан өту",0]]],
  ["🚘","Өткелге көлік жақындап келеді. Не істейсің?",[["✋","Тоқтап, көліктің тоқтағанына көз жеткізу",1],["🏃","Көліктің алдынан жүгіріп өту",0],["📱","Телефонға қарау",0]]]
 ]
}
];

const $ = id => document.getElementById(id);
const modal = $("gameModal");
const art = $("modalArt");
const question = $("modalQuestion");
const answers = $("modalAnswers");
const feedback = $("modalFeedback");
const next = $("modalNext");
const progress = $("modalProgressFill");
const kicker = $("modalKicker");
const close = $("closeModal");
const toast = $("toast");

let activeGame = 0;
let questionIndex = 0;
let score = 0;
let answered = false;
let finished = false;
let bestScores = [0,0,0];
let completed = new Set();
let toastTimer;

function showToast(message){
 toast.textContent = message;
 toast.classList.add("visible");
 clearTimeout(toastTimer);
 toastTimer = setTimeout(()=>toast.classList.remove("visible"),2400);
}

function updateStats(){
 const total = bestScores.reduce((sum,n)=>sum+n,0);
 $("totalStars").textContent = total;
 $("heroStars").textContent = total;

 document.querySelectorAll("[data-score]").forEach(el=>{
  const i = Number(el.dataset.score);
  el.textContent = bestScores[i];
 });
 document.querySelectorAll(".level-card").forEach((card,i)=>{
  card.classList.toggle("level-completed",completed.has(i));
  const btn = card.querySelector(".level-button");
  btn.textContent = completed.has(i) ? "Қайта ойнау ↻" : "Ойнау →";
 });
}

function openGame(index){
 if(!Number.isInteger(index)||!games[index])return;
 activeGame=index;
 questionIndex=0;
 score=0;
 answered=false;
 finished=false;
 modal.classList.add("open");
 modal.setAttribute("aria-hidden","false");
 document.body.classList.add("modal-open");
 renderQuestion();
}

function closeGame(){
 modal.classList.remove("open");
 modal.setAttribute("aria-hidden","true");
 document.body.classList.remove("modal-open");
}

function renderQuestion(){
 const game=games[activeGame];
 const q=game.questions[questionIndex];
 answered=false;
 finished=false;
 kicker.textContent=`0${activeGame+1} / ${game.title.toLocaleUpperCase("kk-KZ")}`;
 art.textContent=q[0];
 question.textContent=q[1];
 feedback.textContent="";
 feedback.className="modal-feedback";
 next.disabled=true;
 next.textContent=questionIndex===game.questions.length-1?"Нәтижені көру ★":"Келесі сұрақ →";
 progress.style.width=`${questionIndex/game.questions.length*100}%`;
 answers.replaceChildren();

 const shuffled=[...q[2]].sort(()=>Math.random()-.5);
 shuffled.forEach((item,i)=>{
  const btn=document.createElement("button");
  btn.type="button";
  btn.className="modal-answer";
  const emoji=document.createElement("span");
  emoji.className="answer-emoji";
  emoji.textContent=item[0];
  const label=document.createElement("span");
  label.textContent=item[1];
  const letter=document.createElement("span");
  letter.className="answer-letter";
  letter.textContent=String.fromCharCode(65+i);
  btn.append(emoji,label,letter);
  btn.addEventListener("click",()=>chooseAnswer(btn,item[2]===1));
  answers.appendChild(btn);
 });
}

function chooseAnswer(selected,correct){
 if(answered||finished)return;
 answered=true;
 const buttons=[...answers.querySelectorAll("button")];
 buttons.forEach(btn=>btn.disabled=true);

 if(correct){
  score++;
  selected.classList.add("correct");
  feedback.textContent="✨ Дұрыс! Жарайсың!";
  feedback.classList.add("good");
 }else{
  selected.classList.add("wrong");
  const right=games[activeGame].questions[questionIndex][2].find(a=>a[2]===1);
  const rightButton=buttons.find(btn=>
   btn.querySelector(".answer-emoji").textContent===right[0] &&
   btn.children[1].textContent===right[1]
  );
  if(rightButton)rightButton.classList.add("correct");
  feedback.textContent="💡 Қайта ойланып көр! Жасыл түс дұрыс жауапты көрсетеді.";
  feedback.classList.add("bad");
 }
 progress.style.width=`${(questionIndex+1)/games[activeGame].questions.length*100}%`;
 next.disabled=false;
}

function nextQuestion(){
 if(finished){
  closeGame();
  $("levels").scrollIntoView({behavior:"smooth"});
  return;
 }
 if(!answered)return;
 if(questionIndex<games[activeGame].questions.length-1){
  questionIndex++;
  renderQuestion();
 }else{
  finishGame();
 }
}

function finishGame(){
 if(finished)return;
 finished=true;
 const firstTime=!completed.has(activeGame);
 completed.add(activeGame);
 bestScores[activeGame]=Math.max(bestScores[activeGame],score);
 updateStats();

 progress.style.width="100%";
 kicker.textContent="СЕНІҢ НӘТИЖЕҢ";
 art.textContent=score===5?"🏆":score>=3?"🌟":"🌱";
 question.textContent=score===5?"Керемет нәтиже!":score>=3?"Жарайсың! Жақсы жұмыс!":"Жақсы бастама!";
 answers.replaceChildren();

 const result=document.createElement("div");
 result.style.cssText="text-align:center;padding:18px 0;font-size:19px;font-weight:850;color:#e0a000";
 result.textContent="★".repeat(score)+"☆".repeat(5-score);
 const detail=document.createElement("p");
 detail.style.cssText="text-align:center;color:#71809a;margin:0 0 10px";
 detail.textContent=`${score} / 5 дұрыс жауап`;
 answers.append(result,detail);

 feedback.className="modal-feedback good";
 feedback.textContent=score===5?"🎉 Барлық сұраққа дұрыс жауап бердің!":"💛 Үйренуді жалғастыр! Әр талпыныс маңызды.";
 next.disabled=false;
 next.textContent="Басқа деңгейді таңдау";
 showToast(firstTime?"✨ Деңгей аяқталды!":"⭐ Нәтиже сақталды!");
}

// Барлық батырмаларға әрекет беру.
document.querySelectorAll("[data-game]").forEach(btn=>{
 btn.addEventListener("click",()=>openGame(Number(btn.dataset.game)));
});
$("heroPlay").addEventListener("click",()=> $("levels").scrollIntoView({behavior:"smooth"}));
$("navPlay").addEventListener("click",()=> $("levels").scrollIntoView({behavior:"smooth"}));
$("aboutPlay").addEventListener("click",()=> $("levels").scrollIntoView({behavior:"smooth"}));
next.addEventListener("click",nextQuestion);
close.addEventListener("click",closeGame);

modal.addEventListener("click",e=>{
 if(e.target===modal)closeGame();
});
document.addEventListener("keydown",e=>{
 if(e.key==="Escape"&&modal.classList.contains("open"))closeGame();
});

document.querySelectorAll('a[href^="#"]').forEach(link=>{
 link.addEventListener("click",e=>{
  const target=$(link.getAttribute("href").slice(1));
  if(target){
   e.preventDefault();
   target.scrollIntoView({behavior:"smooth"});
  }
 });
});

updateStats();
</script>
</body>
</html>
